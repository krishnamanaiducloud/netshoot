+fn localized_name(names: &maxminddb::geoip2::Names<'_>, locale: &str) -> Option<String> {
+    let value = match locale {
+        "de" => names.german,
+        "en" => names.english,
+        "es" => names.spanish,
+        "fr" => names.french,
+        "ja" => names.japanese,
+        "pt-BR" | "pt_BR" | "pt" => names.brazilian_portuguese,
+        "ru" => names.russian,
+        "zh-CN" | "zh_CN" | "zh" => names.simplified_chinese,
+        _ => None,
+    };
+
+    value.or(names.english).map(ToString::to_string)
+}
